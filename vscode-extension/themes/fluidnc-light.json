{
    "name": "CNC GCode Light",
    "type": "light",
    "tokenColors": [
        { "scope": ["comment.block.fluidnc", "comment.line.semicolon.fluidnc"],
          "settings": { "foreground": "#2e7d32" } },
        { "scope": "variable.name.fluidnc",
          "settings": { "foreground": "#e65100", "fontStyle": "italic" } },
        { "scope": "keyword.control.label.fluidnc",
          "settings": { "foreground": "#1565c0", "fontStyle": "bold" } },
        { "scope": "keyword.control.flow.fluidnc",
          "settings": { "foreground": "#0d47a1", "fontStyle": "bold" } },
        { "scope": "support.function.fluidnc",
          "settings": { "foreground": "#6a1b9a", "fontStyle": "bold" } },
        { "scope": ["keyword.operator.assignment.fluidnc", "keyword.operator.arithmetic.fluidnc"],
          "settings": { "foreground": "#b71c1c" } },
        { "scope": "keyword.operator.fluidnc",
          "settings": { "foreground": "#b71c1c" } },
        { "scope": "keyword.other.fluidnc",
          "settings": { "foreground": "#0066aa", "fontStyle": "bold" } },
        { "scope": "entity.name.type.fluidnc",
          "settings": { "foreground": "#b5640f", "fontStyle": "bold" } },
        { "scope": "support.constant.fluidnc",
          "settings": { "foreground": "#008577" } },
        { "scope": "support.type.property-name.fluidnc",
          "settings": { "foreground": "#1976d2", "fontStyle": "bold" } },
        { "scope": "constant.language.fluidnc",
          "settings": { "foreground": "#388e3c", "fontStyle": "bold" } },
        { "scope": "string.quoted.fluidnc",
          "settings": { "foreground": "#7b1fa2", "fontStyle": "bold" } },
        { "scope": "variable.parameter.fluidnc",
          "settings": { "foreground": "#6a8759" } },
        { "scope": "support.type.fluidnc",
          "settings": { "foreground": "#a65e3e" } },
        { "scope": "constant.numeric.fluidnc",
          "settings": { "foreground": "#795548" } },
        { "scope": "punctuation.section.brackets.fluidnc",
          "settings": { "foreground": "#e65100", "fontStyle": "bold" } }
    ]
}
