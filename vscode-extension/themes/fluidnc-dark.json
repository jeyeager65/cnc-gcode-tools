          "settings": { "foreground": "#90caf9", "fontStyle": "bold" } },
        { "scope": "support.function.fluidnc",
          "settings": { "foreground": "#ce93d8", "fontStyle": "bold" } },
        { "scope": ["keyword.operator.assignment.fluidnc", "keyword.operator.arithmetic.fluidnc"],
